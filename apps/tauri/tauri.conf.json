{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ponlet",
  "version": "0.1.0",
  "identifier": "jp.yasagure.ponlet",
  "build": {
    "beforeDevCommand": "npm --prefix ../web-ui run dev -- --mode tauri --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../web-ui run build -- --mode tauri",
    "frontendDist": "../../web-ui/dist/native"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ponlet",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: ponletbin: http://ponletbin.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false
  }
}
