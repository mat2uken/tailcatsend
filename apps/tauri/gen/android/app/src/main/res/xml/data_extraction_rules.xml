<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Relative to getFilesDir(): preserve preferences and sibling files. -->
        <exclude domain="file" path="received/" />
        <exclude domain="sharedpref" path="ponlet_privacy_state.xml" />
    </cloud-backup>
    <!-- Original telemetry_prefs.xml (opt-out) remains eligible for restore. -->
    <device-transfer>
        <exclude domain="sharedpref" path="ponlet_privacy_state.xml" />
    </device-transfer>
</data-extraction-rules>
