<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy Android <=30 format: the exclusion applies to both cloud and D2D.
     Ponlet currently requires API31+, which uses data_extraction_rules instead. -->
<full-backup-content>
    <exclude domain="file" path="received/" />
    <!-- Keep existing telemetry opt-out; never restore a queue without its Keystore keys. -->
    <exclude domain="sharedpref" path="ponlet_privacy_state.xml" />
</full-backup-content>
