<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Ponlet has no advertising use. Keep measurement/crash reporting separate. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <!-- QR scanning is optional; URL paste works without any camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.tailsend_tauri"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Feature builds block Firebase's eager default-app initialization before Application.onCreate. -->
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:enabled="${ponletFirebaseAutoInitEnabled}" tools:replace="android:enabled" />
        <!-- Feature-only known background upload entries; check actual resolved AAR manifest before release. -->
        <receiver android:name="com.google.android.gms.measurement.AppMeasurementReceiver"
            android:enabled="${ponletFirebaseAutoInitEnabled}" tools:replace="android:enabled" />
        <service android:name="com.google.android.gms.measurement.AppMeasurementService"
            android:enabled="${ponletFirebaseAutoInitEnabled}" tools:replace="android:enabled" />
        <service android:name="com.google.android.gms.measurement.AppMeasurementJobService"
            android:enabled="${ponletFirebaseAutoInitEnabled}" tools:replace="android:enabled" />
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            android:enabled="${ponletFirebaseAutoInitEnabled}" tools:replace="android:enabled" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            android:enabled="${ponletFirebaseAutoInitEnabled}" tools:replace="android:enabled" />
        <provider android:name="jp.yasagure.ponlet.platform.PrivacyStartupProvider"
            android:authorities="${applicationId}.ponlet.privacy.startup"
            android:exported="false" android:initOrder="1000" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" tools:replace="android:value" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" tools:replace="android:value" />
        <meta-data android:name="ponlet_privacy_feature_enabled" android:value="${ponletPrivacyFeatureEnabled}" />
        <meta-data android:name="ponlet_privacy_api_origin" android:value="${ponletPrivacyApiOrigin}" />
        <meta-data android:name="ponlet_privacy_audience" android:value="${ponletPrivacyAudience}" />
        <meta-data android:name="ponlet_privacy_policy_version" android:value="${ponletPrivacyPolicyVersion}" />
        <meta-data android:name="ponlet_privacy_receipt_days" android:value="${ponletPrivacyReceiptDays}" />
        <meta-data android:name="ponlet_privacy_observation_days" android:value="${ponletPrivacyObservationDays}" />
        <meta-data android:name="ponlet_privacy_retired_key_policy" android:value="${ponletPrivacyRetiredKeyPolicy}" />
        <meta-data android:name="ponlet_privacy_components_verified" android:value="${ponletPrivacyComponentsVerified}" />
        <meta-data android:name="ponlet_privacy_protocol_verified" android:value="${ponletPrivacyProtocolVerified}" />
        <meta-data android:name="ponlet_privacy_backup_rules_version" android:value="1" />
        <meta-data android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
