{
  "name": "ponlet-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "node ../tests/e2e/test_web_to_web_real.mjs",
    "test:e2e:real:derp": "PONLET_TEST_TRANSPORT=derp node ../tests/e2e/test_web_to_web_real.mjs",
    "test:e2e:android": "node ../tests/e2e/test_android_browser_real.mjs",
    "test:e2e:android:derp": "PONLET_TEST_TRANSPORT=derp node ../tests/e2e/test_android_browser_real.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.js src/ tests/ e2e/",
    "format": "oxfmt --write src/ tests/ e2e/",
    "format:check": "oxfmt --check src/ tests/ e2e/"
  },
  "dependencies": {
    "@nkzw/core": "^1.3.1",
    "@tauri-apps/api": "2.11.1",
    "vanjs-core": "^1.6.1"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
