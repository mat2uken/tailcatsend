@@ -1736,6 +1748,19 @@ func (b *locoBackend) Status() *ipnstate.Status {
 	sb := ipnstate.StatusBuilder{WantPeers: true}
 	mc.UpdateStatus(&sb)
 	eng.UpdateStatus(&sb)
+	// The engine and magicsock report paths and counters, but not peer IPs.
+	// Include the node addresses so callers can identify a connection's peer.
+	b.mu.Lock()
+	for k, node := range b.clients {
+		ips := make([]netip.Addr, 0, len(node.Addresses))
+		for _, addr := range node.Addresses {
+			if addr.IsSingleIP() {
+				ips = append(ips, addr.Addr())
+			}
+		}
+		sb.AddPeer(k, &ipnstate.PeerStatus{TailscaleIPs: ips})
+	}
+	b.mu.Unlock()
 	return sb.Status()
 }
 
