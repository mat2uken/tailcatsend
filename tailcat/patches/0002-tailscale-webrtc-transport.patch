+// TestReceiveWebRTCSlab covers the wireguard-go slab receive API. As with
+// receiveDERP, the single packet starts at offset zero: WireGuard owns any
+// subsequent movement or headroom requirements.
+func TestReceiveWebRTCSlab(t *testing.T) {
+	c := newConn(t.Logf)
+	c.metrics = new(metrics)
+	ep := &endpoint{
+		c:               c,
+		nodeID:          1,
+		publicKey:       key.NewNode().Public(),
+		isWireguardOnly: true,
+	}
+	c.peerMap.upsertEndpoint(ep, key.DiscoPublic{}, false)
+	payload := []byte("wireguard data")
+	// Empty notifications, unknown peers, and oversized datagrams must not
+	// yield an empty successful receive or truncate the following packet.
+	c.webrtcRecvCh <- webrtcReadResult{}
+	c.webrtcRecvCh <- webrtcReadResult{buf: []byte{}, n: 0, src: ep.publicKey}
+	c.webrtcRecvCh <- webrtcReadResult{buf: payload, n: len(payload), src: key.NewNode().Public()}
+	c.webrtcRecvCh <- webrtcReadResult{buf: make([]byte, 65), n: 65, src: ep.publicKey}
+	c.webrtcRecvCh <- webrtcReadResult{buf: payload, n: len(payload), src: ep.publicKey}
+	close(c.webrtcRecvCh)
+	bind := &connBind{Conn: c}
+	var receive conn.ReceiveFunc = bind.receiveWebRTC
+	slab := make([]byte, 64)
+	packets := []conn.ReceivedPacket{{Offset: 7, Size: 1}, {Offset: 31, Size: 2}}
+	n, err := receive(slab, packets)
+	if err != nil || n != 1 {
+		t.Fatalf("receive = (%d, %v), want (1, nil)", n, err)
+	}
+	if packets[0].Offset != 0 || packets[0].Size != len(payload) || packets[0].Endpoint != ep {
+		t.Fatalf("packet metadata: offset=%d size=%d matching endpoint=%v", packets[0].Offset, packets[0].Size, packets[0].Endpoint == ep)
+	}
+	if !bytes.Equal(packets[0].Bytes(slab), payload) {
+		t.Fatalf("packet bytes = %q, want %q", packets[0].Bytes(slab), payload)
+	}
+	if packets[1].Offset != 31 || packets[1].Size != 2 {
+		t.Fatal("receive modified metadata outside the returned packet count")
+	}
+	if n, err := receive(slab, packets); n != 0 || !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("closed channel receive = (%d, %v), want (0, net.ErrClosed)", n, err)
+	}
+}
+
+func TestReceiveWebRTCClosedBind(t *testing.T) {
+	c := newConn(t.Logf)
+	c.webrtcRecvCh <- webrtcReadResult{}
+	bind := &connBind{Conn: c, closed: true}
+	if n, err := bind.receiveWebRTC(make([]byte, 64), make([]conn.ReceivedPacket, 1)); n != 0 || !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("closed bind receive = (%d, %v), want (0, net.ErrClosed)", n, err)
+	}
+}
