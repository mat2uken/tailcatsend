+// findEndpointByDisco returns the first endpoint with the given disco key, or nil if not found.
+func (c *Conn) findEndpointByDisco(dk key.DiscoPublic) *endpoint {
+	// peerMap access requires c.mu; forEachEndpointWithDiscoKey reads byNodeKey,
+	// which is only guarded by c.mu (not peerMap's own nodesMu).
+	c.mu.Lock()
+	defer c.mu.Unlock()
