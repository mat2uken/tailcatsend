/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' https://www.gstatic.com; connect-src 'self' https://tailcat.dev wss://*.tailscale.com wss://*.derp.tailscale.com wss://* ws://* https://*.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://firebaseinstallations.googleapis.com https://firebaseremoteconfig.googleapis.com https://firebaselogging-pa.googleapis.com; img-src 'self' data: https://*.google-analytics.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://www.gstatic.com; object-src 'none'; frame-ancestors 'none';
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*.wasm.gz
  Content-Type: application/gzip
  Cache-Control: no-cache

/pkg/*.wasm.gz
  Content-Type: application/gzip
  Cache-Control: no-cache

/assets/*.js
  Cache-Control: no-cache

/pkg/*.js
  Cache-Control: no-cache

/assets/*.wasm
  Content-Type: application/wasm
  Cache-Control: no-cache

/pkg/*.wasm
  Content-Type: application/wasm
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-store
